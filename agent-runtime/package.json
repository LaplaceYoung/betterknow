{
  "name": "betterknow-agent-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "betterknow 的 Agent 核心：上游 DeepSeek Harness runtime（dsh + dsh-headless + dsh-base），项目内独立 DSH_HOME，扩展以插件形式自研",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dsh": "DSH_HOME=./home dsh",
    "run:betterknow": "DSH_HOME=./home dsh --profile betterknow",
    "dump-config": "DSH_HOME=./home dsh --profile betterknow --dump-config"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-base": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-headless": "^0.1.5-rc.2"
  },
  "allowScripts": {
    "node-pty@1.2.0-beta.15": true,
    "koffi@3.2.1": true,
    "@deepseek-ai/dsh-subprocess-local@0.1.5-rc.2": true
  }
}
