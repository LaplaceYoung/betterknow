  "/r/{slug}": {
   "get": {
    "tags": [
     "campaigns"
    ],
    "summary": "Scan",
    "description": "Count the scan, then send the visitor to the campaign's destination.\n\nCounting must never cost a visitor their redirect: a database hiccup is\nlogged and swallowed. The response is explicitly uncacheable — a cached 302\nwould silently stop the counter for everyone behind that cache.",
    "operationId": "scan_r__slug__get",
    "parameters": [
     {
      "name": "slug",
