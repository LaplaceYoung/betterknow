  "/api/admin/partners/dub-sync": {
   "get": {
    "tags": [
     "admin"
    ],
    "summary": "Dub Sync",
    "description": "What Dub still knows about each partner we list.\n\nDeclared before /partners/{partner_id} so the literal path wins the match.\n\nThe dashboard's list comes from our own table, so a partner ended in Dub\nstays on screen forever with nothing to say it is gone. This reads Dub's\npartner list once and reports, per row, the enrolment status ('approved',\n'deactivated', 'banned', ...) or 'missing' when Dub has no such partner at\nall. Read-only on purpose: what to do about a stale row — delete it, disable\nit, leave it — stays the admin's call.",
    "operationId": "dub_sync_api_admin_partners_dub_sync_get",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {}
       }
      }
     }
    }
   }
  },
  "/api/admin/partners/{partner_id}": {
   "delete": {
    "tags": [
     "admin"
    ],
    "summary": "Delete Partner",
    "description": "Remove a KOL from this dashboard, and end their Dub enrolment by default.\n\nRedemptions are the reward ledger for real users, so a partner who has any\nis never deleted — 409, disable it instead. Dub is asked first: if it refuses\nfor any reason other than \"no such partner\", nothing is deleted here either,\nso the admin can retry or fall back to `deactivate_in_dub=false` and clean up\nDub by hand. (Dub has no partner delete at all; see dub.deactivate_partner.)",
    "operationId": "delete_partner_api_admin_partners__partner_id__delete",
    "parameters": [
     {
      "name": "partner_id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "title": "Partner Id"
      }
     },
     {
      "name": "deactivate_in_dub",
      "in": "query",
      "required": false,
      "schema": {
       "type": "boolean",
       "default": true,
       "title": "Deactivate In Dub"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {}
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   },
   "get": {
    "tags": [
     "admin"
    ],
    "summary": "Get Partner",
    "operationId": "get_partner_api_admin_partners__partner_id__get",
    "parameters": [
