  "/api/campaigns/events": {
   "post": {
    "tags": [
     "campaigns"
    ],
    "summary": "Record Event",
    "description": "Called by the HyperKnow backend when a user who arrived through a\ncampaign link signs up or pays.\n\nThe caller passes whatever it read from `hk_campaign` on the landing URL.\nRetries are free: the row carries a `dedupe_key` built from `event_id` when\ngiven, and from (campaign, user) otherwise, so a repeat call returns\n`{\"recorded\": false, \"duplicate\": true}` instead of inflating the numbers.\nSend an `event_id` for purchases — without one, a renewal by the same user\nlooks like the same purchase.\n\nEvents are accepted for disabled and archived campaigns too: someone who\nscanned the poster last week still deserves to be attributed this week.",
    "operationId": "record_event_api_campaigns_events_post",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/CampaignEvent"
       }
      }
     },
     "required": true
    },
    "responses": {
     "201": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {}
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
